#!/usr/bin/env node
// pagent-secret <名字>：从保险箱取一条凭据，原样打到标准输出（不带换行），用在命令里：
//   curl -H "Authorization: Bearer $(pagent-secret GITHUB_TOKEN)" https://api.github.com/user
// 凭这一轮的令牌向 pagentd 取，这一轮结束后就取不到了；每次取用都记在时间线上。
const name = process.argv[2];
const url = process.env.PAGENT_SECRET_URL;
const auth = process.env.PAGENT_RUN_AUTH;
if (!name) { console.error('用法：pagent-secret <名字>（list_secrets 工具能列出有哪些）'); process.exit(2); }
if (!url || !auth) { console.error('pagent-secret 只能在 Agent 的一轮里用'); process.exit(2); }
const res = await fetch(url, {
  method: 'POST', headers: { authorization: auth, 'x-pagent-run': process.env.PAGENT_RUN_ID ?? '', 'content-type': 'application/json' },
  body: JSON.stringify({ name }),
}).catch((e) => { console.error(`取不到：${e.message}`); process.exit(1); });
const d = await res.json().catch(() => ({}));
if (!res.ok) { console.error(`${d.error ?? `HTTP ${res.status}`}${d.names ? `。可用的：${d.names.join('、') || '（空）'}` : ''}`); process.exit(1); }
process.stdout.write(d.value ?? '');
